# Build context excludes — keep the image small and the build reproducible.
.git
.github
.claude
.vscode
node_modules
.next
out
build
coverage

infra
*.md
LICENSE

# Tests never run in the image — the build only needs app source.
vitest.config.mts
vitest.setup.ts
**/*.test.ts
**/*.test.tsx
e2e
playwright.config.ts
playwright-report
test-results

.env
.env.*
!.env.example

Dockerfile
.dockerignore
docker-compose*.yml

npm-debug.log*
*.tsbuildinfo
.DS_Store
league.db
